# Configuration for Softeria's ms-365-mcp-server (our build, see README) as a Claude relay
# (On-Behalf-Of, one container). Copy to relay.env, fill in the <...> values,
# keep the two SECRET values in your platform's secret store.
#
# Image: ghcr.io/rmdevpro/ms-365-mcp-server@sha256:456eb842902d32a5b95cdaff2f0db523dffa89af0abb11e4698c6af9c03bcf88 (Softeria 0.176.0 + #775, #777)
# Args:  --http 0.0.0.0:3000 --enable-attachment-urls
# Port:  3000, behind your HTTPS ingress. Exactly one replica.

# --- the app registration (docs/entra.md) ---
MS365_MCP_OBO=true
MS365_MCP_CLIENT_ID=<application (client) id>
MS365_MCP_CLIENT_SECRET=<SECRET: client secret>
MS365_MCP_TENANT_ID=<directory (tenant) id, or consumers for personal accounts>
# Work tenant (remove for personal accounts):
MS365_MCP_ORG_MODE=true

# --- the public origin of this container ---
MS365_MCP_PUBLIC_URL=https://<relay host>
MS365_MCP_ATTACHMENT_URL_BASE=https://<relay host>
MS365_MCP_ATTACHMENT_URL_KEY=<SECRET: 64 random hex characters, e.g. openssl rand -hex 32>
MS365_MCP_ATTACHMENT_URL_TTL_S=300

# --- scopes: the tool surface and what users consent to (keep both identical) ---
MS365_MCP_ALLOWED_SCOPES=User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Contacts.ReadWrite MailboxSettings.ReadWrite Files.ReadWrite
MS365_MCP_EXTRA_SCOPES=User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Contacts.ReadWrite MailboxSettings.ReadWrite Files.ReadWrite

# --- tools replaced by better ones (base64 file tools -> download/upload links) ---
ENABLED_TOOLS=^(?!(?:download-bytes|download-bytes-to-file|get-mail-attachment-content|add-mail-attachment|create-mail-attachment-upload-session|add-calendar-event-attachment|create-calendar-event-attachment-upload-session|graph-batch)$)

# --- who may use it, and the OAuth surface ---
MS365_MCP_OBO_ALLOWED_TENANTS=<the same tenant id; personal accounts: 9188040d-6c67-4c5b-b112-36a304b66dad>
# Optional, narrow to named users (object ids, comma-separated):
# MS365_MCP_OBO_ALLOWED_USERS=
MS365_MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
MS365_MCP_DISABLE_DCR=true

# --- proxies in front of the container (one HTTPS ingress = 1) ---
MS365_MCP_TRUST_PROXY_HOPS=1
